<Window x:Class="Space_Intruder.UpgradeScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Space_Intruder"
        mc:Ignorable="d"
        Title="Wybierz Ulepszenia" 
        Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Styl średniowieczny dla przycisków -->
        <Style x:Key="MedievalButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#8B4513"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontFamily" Value="Old English Text MT"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle x:Name="glow" Opacity="0" Fill="#FFD700" RadiusX="5" RadiusY="5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla punktów ulepszeń -->
        <Style x:Key="UpgradePointStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Fill" Value="#FFD700"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFD700" BlurRadius="10" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Tło -->
        <Grid.Background>
            <ImageBrush ImageSource="Images/background_menu.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Efekt przyciemnienia tła -->
        <Rectangle Fill="Black" Opacity="0.4"/>

        <!-- Główny kontener -->
        <Border Background="#22000000" BorderBrush="#8B4513" BorderThickness="2" CornerRadius="10" 
                Margin="50" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tytuł -->
                <TextBlock Text="WYBIERZ ULEPSZENIA" 
                           Grid.Row="0"
                           FontFamily="Old English Text MT" 
                           FontSize="36" 
                           Foreground="#FFD700" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,30">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Punkty ulepszeń -->
                <StackPanel x:Name="PointsPanel" 
                            Grid.Row="1"
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">
                </StackPanel>

                <TextBlock x:Name="PointsText" 
                           Grid.Row="2"
                           Text="Pozostało ulepszeń: 3/3" 
                           FontFamily="Old English Text MT"
                           Foreground="#FFD700" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"
                           FontSize="20"/>

                <!-- Przyciski ulepszeń -->
                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <Button x:Name="DamageUpgradeBtn" Content="+2 Obrażenia" 
                            Style="{StaticResource MedievalButton}"
                            Width="300" Height="50" Margin="0,10"
                            Click="DamageUpgrade_Click"
                            ToolTip="Zwiększa obrażenia pocisków">
                        <Button.Effect>
                            <DropShadowEffect Color="#8B0000" BlurRadius="10"/>
                        </Button.Effect>
                    </Button>

                    <Button x:Name="AttackSpeedUpgradeBtn" Content="+0.5 Szybkostrzelność" 
                            Style="{StaticResource MedievalButton}"
                            Width="300" Height="50" Margin="0,10"
                            Click="AttackSpeedUpgrade_Click"
                            ToolTip="Zmniejsza czas między strzałami">
                        <Button.Effect>
                            <DropShadowEffect Color="#006400" BlurRadius="10"/>
                        </Button.Effect>
                    </Button>

                    <Button x:Name="MovementUpgradeBtn" Content="+5 Prędkość ruchu" 
                            Style="{StaticResource MedievalButton}"
                            Width="300" Height="50" Margin="0,10"
                            Click="MovementUpgrade_Click"
                            ToolTip="Zwiększa prędkość poruszania się">
                        <Button.Effect>
                            <DropShadowEffect Color="#00008B" BlurRadius="10"/>
                        </Button.Effect>
                    </Button>

                    <Button x:Name="HealthUpgradeBtn" Content="+1 Życie" 
                            Style="{StaticResource MedievalButton}"
                            Width="300" Height="50" Margin="0,10"
                            Click="HealthUpgrade_Click"
                            ToolTip="Dodaje dodatkowy punkt życia">
                        <Button.Effect>
                            <DropShadowEffect Color="#8B008B" BlurRadius="10"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <!-- Przycisk kontynuacji -->
                <Button x:Name="ContinueBtn" 
                        Grid.Row="4"
                        Content="KONTYNUUJ" 
                        Style="{StaticResource MedievalButton}"
                        Width="250" Height="50" 
                        Margin="0,30,0,10"
                        Click="Continue_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="15"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>

        <!-- Przycisk wyjścia -->
        <Button x:Name="ExitBtn" Content="X" 
                Width="30" Height="30" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,20,20,0" 
                Background="Transparent" BorderBrush="Transparent" 
                Foreground="#FFD700" FontWeight="Bold"
                Click="ExitBtn_Click">
            <Button.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="5"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>
<Window x:Class="Space_Intruder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Space_Intruder"
        mc:Ignorable="d"
        Title="Space Intruder"
        Width="1200"
        Height="600"
        KeyDown="Window_KeyDown">

    <Grid>
        <Canvas x:Name="MyCanvas">
            <Canvas.Background>
                <ImageBrush ImageSource="pack://application:,,,/Images/background.jpg" Stretch="UniformToFill"/>
            </Canvas.Background>
        </Canvas>

        <!-- Górny panel z poziomem -->
        <TextBlock x:Name="current_level" Text="Level 1" FontSize="24" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <!-- Dolny prawy panel z życiami -->
        <StackPanel x:Name="LifeContainer" Orientation="Horizontal" 
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
            <!-- Serduszka będą dodawane dynamicznie w kodzie -->
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="Space_Intruder.WynikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Space_Intruder"
        mc:Ignorable="d"
        Title="WynikiWindow" Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- Styl średniowieczny dla przycisków -->
        <Style x:Key="MedievalButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#8B4513"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontFamily" Value="Old English Text MT"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle x:Name="glow" Opacity="0" Fill="#FFD700" RadiusX="5" RadiusY="5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla nagłówków kolumn -->
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Old English Text MT"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <!-- Styl dla danych w liście -->
        <Style x:Key="DataItemStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Tło - takie samo jak w StartWindow -->
        <MediaElement x:Name="VideoBackground"
                      Source="Video/zamek.mp4"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      MediaEnded="VideoBackground_MediaEnded">
            <MediaElement.Effect>
                <BlurEffect Radius="1"/>
                <!-- Lekkie rozmycie dla lepszej czytelności -->
            </MediaElement.Effect>
        </MediaElement>

        <!-- Efekt przyciemnienia tła -->
        <Rectangle Fill="Black" Opacity="0.4"/>

        <!-- Główny kontener -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tytuł -->
            <TextBlock Text="RANKING GRACZY" 
                       Grid.Row="0"
                       FontFamily="Old English Text MT" 
                       FontSize="36" 
                       Foreground="#FFD700" 
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Lista wyników -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nagłówki kolumn -->
                    <TextBlock Text="Gracz" Grid.Column="0" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Text="Poziom" Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Text="Czas" Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Text="Wynik" Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}"/>

                    <!-- Dane - zostaną wypełnione z kodu -->
                    <ItemsControl x:Name="ResultsList" Grid.ColumnSpan="4" Margin="0,30,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding PlayerName}" Grid.Column="0" Style="{StaticResource DataItemStyle}"/>
                                    <TextBlock Text="{Binding Level}" Grid.Column="1" Style="{StaticResource DataItemStyle}"/>
                                    <TextBlock Text="{Binding Time}" Grid.Column="2" Style="{StaticResource DataItemStyle}"/>
                                    <TextBlock Text="{Binding Result}" Grid.Column="3" Style="{StaticResource DataItemStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Przycisk powrotu -->
            <Button x:Name="BackButton" Content="Powrót" 
                    Grid.Row="2"
                    Style="{StaticResource MedievalButton}"
                    Width="150" Height="40" Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="BackButton_Click">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
            </Button>
        </Grid>

        <!-- Przycisk wyjścia -->
        <Button x:Name="ExitBtn" Content="X" 
                Width="30" Height="30" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,10,10,0" 
                Background="Transparent" BorderBrush="Transparent" 
                Foreground="#FFD700" FontWeight="Bold"
                Click="ExitBtn_Click">
            <Button.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="5"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>